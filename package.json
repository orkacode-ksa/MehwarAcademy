{
  "name": "mihwar-academic-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "packages/shared"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "test": "npm run test --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server",
    "start": "npm run start --workspace=server"
  },
  "engines": {
    "node": ">=20"
  }
}
