// مِحوَر — مخطط قاعدة البيانات
//
// مستويان للعزل، لا يُخلط بينهما:
//   Tenant    = المؤسسة المستأجِرة (جامعة/كلية). حدّ الأمان الحقيقي، ويُفرض بجدارين:
//               امتداد Prisma في التطبيق + سياسات RLS في Postgres.
//   Workspace = مساحة عمل عضو هيئة التدريس داخل المستأجر. حدّ تنظيمي لا أمني.
//
// كل جدول في مستوى بيانات المستأجر يحمل `tenantId` مفهرسًا — مُكرَّرًا عمدًا (denormalized)
// حتى تكون سياسة RLS مقارنة عمود واحد بلا joins. انظر docs/roadmap.md §١.٢.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── المستأجر (المؤسسة) ─────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// المؤسسة المستأجِرة. حسابات المنصة نفسها (دور OWNER) تنتمي لمستأجر النظام
/// `PLATFORM_TENANT_SLUG` — فيبقى `tenantId` غير قابل للعدم في كل مكان، وتبقى
/// سياسات RLS موحّدة الشكل بلا حالة خاصة.
model Tenant {
  id       String       @id @default(cuid())
  /// مُحتفظ به من اليوم الأول: النطاق موحّد الآن، فيصير النطاق الفرعي لاحقًا إعدادًا لا هجرة.
  slug     String       @unique
  name     String
  /// رمز انضمام أعضاء هيئة التدريس — يُعطيه المالك للأستاذ فيسجّل داخل جامعته
  /// (لائحتها وتقويمها) بدل مستأجر شخصي فارغ.
  joinCode String?      @unique
  status   TenantStatus @default(TRIAL)
  /// ظاهرة في قائمة «جامعتك» عند التسجيل — بقرار المالك وحده (إنشاء جامعة أو اعتمادها).
  listed   Boolean      @default(false)
  /// مفتاح الجامعة في قائمة الجامعات المقنّنة — جامعة واحدة = مساحة واحدة مهما اختلف من سجّل أولًا.
  catalogKey String?    @unique

  /// توجيه مزوّد الذكاء لكل مستأجر — جامعة ترفض مزوّدًا تُشغَّل على غيره بلا إعادة بناء.
  aiProvider         String?
  /// سقف الإنفاق الشهري. عند بلوغه: تدهور آمن للموجّه الحتمي، لا انقطاع.
  aiMonthlyBudgetUsd Decimal @default(25) @db.Decimal(8, 2)

  /// استحقاقات الميزات (الاستيديو · المساعد · البودكاست · التصدير المؤسسي).
  entitlements Json @default("{}")

  brandColor       String?
  brandLogoAssetId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments   Department[]
  users         User[]
  workspaces    Workspace[]
  subscriptions Subscription[]
  Regulation    Regulation?
  AcademicYear  AcademicYear[]

  @@index([status])
  @@map("tenants")
}

/// لائحة الجامعة — مصدر كل ما يراه الأستاذ من «مطلوب».
///
/// **القرار الحاكم:** المنصة لا تفرض معيارًا. مؤشرات الالتزام وبنود ملف المقرر في
/// الإصدار الأول كانت لوائح جامعة أم القرى معروضة كأنها قانون المنصة — فأي جامعة أخرى
/// تجدها غريبة، وأي تعديل في لوائح أم القرى نفسها كان يحتاج إصدارًا برمجيًا.
/// الآن: المالك يعرّف، والمنصة تنفّذ.
///
/// الحقول Json عمدًا: بنود اللائحة تختلف بين الجامعات اختلافًا لا يُحصى بأعمدة، وتغييرها
/// يجب أن يكون تحرير صف لا هجرة قاعدة بيانات.
model Regulation {
  id       String @id @default(cuid())
  tenantId String @unique

  /// بنود ملف المقرر المطلوبة: [{ key, label, required }]
  courseFileItems   Json @default("[]")
  /// توزيع الدرجات الافتراضي: [{ key, label, weight }]
  gradeScheme       Json @default("[]")
  /// سلّم التقديرات: [{ letter, min }]
  letterGrades      Json @default("[]")
  /// سياسة الغياب: { warnPercent, banPercent }
  absencePolicy     Json @default("{}")
  /// أنواع المخالفات: [{ key, label, severity, action, escalateAfter? }]
  /// الجامعة تعرّف أنواعها وعقوباتها، والمنصة تسجّل وتعدّ وتُصعّد.
  violationTypes    Json @default("[]")
  /// مؤشرات تقييم الأداء وأوزانها: [{ key, weight }] — المفاتيح من قائمة ثابتة في
  /// `rules/performance.ts` لأن كل مؤشر يُحسب من بيانات حقيقية، والأوزان للجامعة.
  performanceKpis   Json @default("[]")
  /// تسميات تحلّ محل الافتراضية في الواجهة: { course: "مقرر", section: "شعبة", ... }
  terminology       Json @default("{}")
  /// مخالفات أعضاء هيئة التدريس: [{ key, label, category, check }] — يرفعها الأساتذة ويعتمدها المالك،
  /// و`check` يربط المخالفة بمؤشر محسوب فيرى الأستاذ التزامه بها آليًا.
  facultyViolations Json @default("[]")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("regulations")
}

/// القسم الأكاديمي — نطاق رئيس القسم.
model Department {
  id        String    @id @default(cuid())
  tenantId  String
  code      String
  nameAr    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaces Workspace[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

// ───────────────────────── الهوية والوصول ─────────────────────────

enum UserRole {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  /// فريد **داخل المستأجر** لا عالميًا: أستاذ متعاون مع جامعتين حساب في كلٍّ منهما.
  /// أثره على الدخول: البريد وحده لا يحسم الحساب — انظر `auth.service.ts`، فإن طابق
  /// أكثر من مستأجر واحد يُسأل المستخدم عن مؤسسته بدل التخمين.
  email           String
  phone           String?
  passwordHash    String
  fullName        String
  role            UserRole
  tokenVersion    Int       @default(0)
  emailVerifiedAt DateTime?

  totpEnabled  Boolean  @default(false)
  totpSecret   String? // AES-256-GCM مشفّر، صيغة v1:iv:authTag:ciphertext
  totpRecovery String[] @default([]) // hashes لرموز الاسترداد

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// إيقاف المالك للحساب (مخالفة · طلب الجامعة) — لا دخول حتى يُرفع، والجلسات القائمة تُبطَل.
  suspendedAt      DateTime?

  foundingMember Boolean @default(false)

  /// رئيس القسم: عضو هيئة تدريس يحتفظ بدوره ومقرراته، ويُضاف له عرض القسم للقراءة.
  /// علَم لا دور مستقل — تحويله إلى دور كان سيُسقط عنه شاشات تدريسه.
  isDeptHead Boolean @default(false)

  /// بيانات السيرة الذاتية الثابتة (الرتبة · التخصص · المؤهلات · النبذة) — والمتغيّر منها
  /// (بحوث · مؤتمرات · دورات) في `FacultyActivity`. منهما تُولَّد «السيرة الذاتية» في ملف المقرر.
  profile Json @default("{}")

  /// تفضيلات العرض (النمط · حجم الخط · خط العناوين · اللغة) — تتبع المستخدم بين أجهزته.
  prefs        Json      @default("{}")
  /// صورة الملف الشخصي (مصغّرة ٢٥٦px بلا بيانات EXIF) — ملف في `files`.
  avatarFileId String?
  /// موظف الإدارة (ADMIN): الشاشات المسموحة له من لوحة المالك
  /// (institutions · users · payments · bank · settings). المالك لا يحتاجها — له كل شيء.
  staffScreens String[] @default([])
  /// آخر مرة فتح الإشعارات: ما بعده «غير مقروء» — عدّ واحد مفهرس لا علَم لكل إشعار.
  notifSeenAt  DateTime?

  createdAt DateTime  @default(now()) @updatedAt
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens        RefreshToken[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]          @relation("WorkspaceOwner")
  auditLogs            AuditLog[]
  enrollments          Enrollment[]
  emailChangeTokens   EmailChangeToken[]
  passwordResetTokens  PasswordResetToken[]
  avatar               UserAvatar?

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique // SHA-256
  device         String?
  ip             String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// تغيير البريد: يُحفظ البريد الجديد ورمز مُجزّأ، ولا يُطبَّق حتى يُفتح الرابط المرسل إليه.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// append-only: تُفرض بـ trigger في هجرة SQL يمنع UPDATE/DELETE على الجدول
model AuditLog {
  id          String   @id @default(cuid())
  /// اختياري عمدًا: أحداث مستوى المنصة (تسجيل دخول فاشل قبل حسم المستأجر) لا مستأجر لها.
  tenantId    String?
  userId      String?
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── مساحات العمل (Tenancy) ─────────────────────────

enum WorkspaceRole {
  OWNER
  TEACHER
  DEPARTMENT_HEAD
}

enum PlanCode {
  MIHWAR
  MIHWAR_PRO
  DEPARTMENT
  STUDENT_PLUS
}

model Workspace {
  id           String    @id @default(cuid())
  tenantId     String
  departmentId String?
  name         String
  planCode     PlanCode  @default(MIHWAR)
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner      User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members    WorkspaceMember[]

  // لا academicYears هنا: السنة والفصل صارا على مستوى الجامعة. إبقاء العلاقة العكسية
  // يجعل Prisma يُعيد عمود workspaceId تلقائيًا — وقد فعل، فكشفه الاختبار لا المراجعة.
  courses        Course[]
  subscription   Subscription?
  qualityItems   QualityFileItem[]
  generationJobs GenerationJob[]

  @@index([tenantId])
  @@index([departmentId])
  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  tenantId    String
  workspaceId String
  userId      String
  role        WorkspaceRole @default(TEACHER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("workspace_members")
}

// ───────────────────────── الفوترة والاشتراكات ─────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE
  READ_ONLY
  FROZEN
  CANCELED
  SCHEDULED_DELETION
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Subscription {
  id                       String             @id @default(cuid())
  tenantId                 String
  workspaceId              String             @unique
  planCode                 PlanCode
  status                   SubscriptionStatus @default(TRIALING)
  billingCycle             BillingCycle       @default(MONTHLY)
  trialEndsAt              DateTime?
  currentPeriodEnd         DateTime?
  graceEndsAt              DateTime?
  readOnlyEndsAt           DateTime?
  frozenEndsAt             DateTime?
  productionMinutesBalance Int                @default(0)
  /// الباقة الفعلية (جدول plans) — `planCode` القديم يبقى للتوافق.
  planId                   String?
  /// مقررات البنك المستعملة من حصة VIP في الدورة الحالية
  bankCoursesUsed          Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  Tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String
  workspaceId    String
  number         String        @unique
  amountRiyals   Decimal       @db.Decimal(10, 2)
  vatRiyals      Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(DRAFT)
  pdfAssetId     String?
  issuedAt       DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([workspaceId])
  @@index([tenantId])
  @@map("invoices")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  invoiceId         String
  provider          String
  providerReference String?
  idempotencyKey    String        @unique
  status            PaymentStatus @default(PENDING)
  amountRiyals      Decimal       @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payments")
}

// حدث webhook خام قبل المعالجة — لمنع المعالجة المزدوجة وللتدقيق
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  rawPayload  Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ───────────────────────── الهيكل الأكاديمي ─────────────────────────

/// السنة الأكاديمية — يُنشئها المالك للجامعة كلها، لا كل أستاذ لنفسه.
/// كانت مربوطة بمساحة عمل الأستاذ، فكان كل أستاذ يخترع تقويمه: تصحيح بنيوي لا تجميلي.
model AcademicYear {
  id        String    @id @default(cuid())
  tenantId  String
  label     String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  semesters Semester[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("academic_years")
}

/// حالة الفصل — تحكم ما يستطيع الأستاذ فعله، فلا حاجة لمنعه بالكلام:
/// PREP يجهّز · ACTIVE يدرّس ويحضّر · GRADING يرصد · CLOSED مُقفل · ARCHIVED للقراءة.
enum TermStatus {
  PREP
  ACTIVE
  GRADING
  CLOSED
  ARCHIVED
}

model Semester {
  id             String     @id @default(cuid())
  tenantId       String
  academicYearId String
  label          String
  startDate      DateTime
  endDate        DateTime
  status         TermStatus @default(PREP)
  /// بعد هذا التاريخ يُقفل الرصد آليًا — لا يعتمد على انتباه أحد.
  gradeLockAt    DateTime?
  /// متى أُقفل الفصل (يدويًا أو آليًا) ومتى سُحبت مقرراته للبنك
  closedAt       DateTime?
  harvestedAt    DateTime?
  createdAt      DateTime   @default(now())
  deletedAt      DateTime?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courses      Course[]
  holidays     Holiday[]

  @@index([academicYearId])
  @@index([tenantId, status])
  @@map("semesters")
}

/// إجازة أو فترة اختبارات — تُطرح من أيام الدراسة وتُستثنى من حسابات الغياب.
model Holiday {
  id         String   @id @default(cuid())
  tenantId   String
  semesterId String
  label      String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  kind       String   @default("HOLIDAY")

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([semesterId])
  @@map("holidays")
}

model Course {
  id                     String    @id @default(cuid())
  tenantId               String
  workspaceId            String
  semesterId             String
  code                   String
  nameAr                 String
  creditHours            Int
  /// مقرر ذو معمل: يفتح خطوة المعمل (دليل · شرائح · تقرير · نشاط · اختبار عملي).
  hasLab                 Boolean   @default(false)
  /// توزيع الدرجات لهذا المقرر — يُنسخ من لائحة الجامعة عند الإنشاء ثم يُحرَّر.
  /// نسخة لا إشارة: تعديل الجامعة لائحتها لا يجوز أن يغيّر أوزان مقرر جارٍ رصده.
  gradeScheme            Json      @default("[]")
  /// متى **أقرّ الأستاذ** التوزيع.
  /// النسخ من اللائحة نقطة انطلاق لا إنجاز: بدون هذا الحقل كانت خطوة الدرجات تظهر
  /// مكتملة لحظة إنشاء المقرر، فيمرّ الأستاذ على أوزان لم يراجعها قط.
  gradeSchemeConfirmedAt DateTime?
  /// توصيف المقرر (الوصف · المخرجات · المراجع ...) — شكله في `courseSpecSchema`.
  spec                   Json      @default("{}")
  /// بنود ملف المقرر — **نسخة** من لائحة الجامعة عند الإنشاء: [{ key, label, required }].
  /// نسخة لا إشارة للسبب نفسه في gradeScheme: ملف مقرر جارٍ لا يتغيّر تحت يد صاحبه.
  fileItems              Json      @default("[]")
  /// سياسة الغياب — نسخة من اللائحة عند الإنشاء: { warnPercent, banPercent }.
  absencePolicy          Json      @default("{}")
  /// المقرر الذي استُنسخ منه هذا المقرر (الأرشفة والاستنساخ).
  clonedFromId           String?
  /// مقرر البنك الذي أُضيف منه هذا المقرر (إن وُجد).
  bankCourseId           String?
  /// حقول تقرير المقرر (نموذج NCAAA) التي يكتبها الأستاذ — والمحسوب منها لا يُخزَّن.
  report                 Json      @default("{}")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  semester       Semester          @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sections       Section[]
  topics         Topic[]
  assessments    Assessment[]
  qualityItems   QualityFileItem[]
  generationJobs GenerationJob[]
  violations     Violation[]

  @@unique([workspaceId, semesterId, code])
  @@index([workspaceId])
  @@index([semesterId])
  @@index([tenantId])
  @@map("courses")
}

model Section {
  id          String    @id @default(cuid())
  tenantId    String
  workspaceId String
  courseId    String
  label       String
  capacity    Int
  /// مواعيد الشعبة الأسبوعية: [{ day: 0-6 (الأحد=0), start: "HH:MM", end: "HH:MM", room? }].
  /// منها وحدها تُعرف «محاضرة اليوم» وعدد المحاضرات الذي تُحسب عليه نسبة الغياب.
  meetings    Json      @default("[]")
  /// رمز انضمام الطالب لهذه الشعبة — يدخل به الطالب حسابه لأول مرة.
  joinCode    String?   @unique
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendance  Attendance[]
  sessions    ClassSession[]

  @@unique([courseId, label])
  @@index([workspaceId])
  @@index([courseId])
  @@index([tenantId])
  @@map("sections")
}

model Enrollment {
  id                 String    @id @default(cuid())
  tenantId           String
  workspaceId        String
  sectionId          String
  studentId          String
  universityIdNumber String
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?

  section    Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student    User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  grades     Grade[]
  violations Violation[]

  @@unique([sectionId, studentId])
  @@index([workspaceId])
  @@index([studentId])
  @@index([tenantId])
  @@map("enrollments")
}

model Topic {
  id               String    @id @default(cuid())
  tenantId         String
  workspaceId      String
  courseId         String
  title            String
  orderIndex       Int
  learningOutcomes String[]  @default([])
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]
  sessions ClassSession[]

  @@index([workspaceId])
  @@index([courseId, orderIndex])
  @@index([tenantId])
  @@map("topics")
}

enum ContentStatus {
  DRAFT
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Lecture {
  id             String        @id @default(cuid())
  tenantId       String
  workspaceId    String
  topicId        String
  title          String
  /// نوع المادة: TEXT · SLIDES · AUDIO · VIDEO · LINK — التوليد خارجي، والمنصة تحفظ الناتج في موضعه.
  kind           String        @default("TEXT")
  /// رابط المادة (NotebookLM · Drive · YouTube ...) حين تكون خارج المنصة.
  url            String?
  scriptText     String?
  slidesAssetId  String?
  videoAssetId   String?
  audioAssetId   String?
  podcastAssetId String?
  status         ContentStatus @default(DRAFT)
  aiGenerated    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([topicId])
  @@index([tenantId])
  @@map("lectures")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

model Attendance {
  id           String           @id @default(cuid())
  tenantId     String
  workspaceId  String
  sectionId    String
  enrollmentId String
  date         DateTime         @db.Date
  status       AttendanceStatus
  createdAt    DateTime         @default(now())

  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([workspaceId])
  @@index([sectionId, date])
  @@index([tenantId])
  @@map("attendance_records")
}

/// محاضرة عُقدت فعلًا — «ابدأ» تُنشئها و«انتهى» تُغلقها.
/// منها يُعرف الموضوع التالي (أول موضوع لم تُعقد له محاضرة) وانتظام تسجيل الحضور.
model ClassSession {
  id          String    @id @default(cuid())
  tenantId    String
  workspaceId String
  sectionId   String
  topicId     String?
  date        DateTime  @db.Date
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([sectionId, date])
  @@index([workspaceId])
  @@index([tenantId])
  @@map("class_sessions")
}

/// مخالفة طالب — نوعها وعقوبتها من لائحة الجامعة (`Regulation.violationTypes`)،
/// وتُنسخ التسمية والدرجة في الصف حتى لا يغيّر تعديل اللائحة سجلًا مضى.
model Violation {
  id           String    @id @default(cuid())
  tenantId     String
  workspaceId  String
  courseId     String
  enrollmentId String
  typeKey      String
  typeLabel    String
  severity     String
  action       String?
  note         String?
  /// MANUAL يسجّلها الأستاذ · AUTO تولّدها قاعدة (الحرمان بالغياب).
  source       String    @default("MANUAL")
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([courseId])
  @@index([enrollmentId])
  @@index([tenantId])
  @@map("violations")
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  MIDTERM
  FINAL
  PARTICIPATION
  OTHER
}

model Assessment {
  id            String         @id @default(cuid())
  tenantId      String
  workspaceId   String
  courseId      String
  title         String
  type          AssessmentType
  maxScore      Decimal        @db.Decimal(6, 2)
  weightPercent Decimal        @db.Decimal(5, 2)
  /// نص التقييم: الأسئلة أو التعليمات — ما يُسلَّم للطالب ويُحفظ نموذجًا في ملف المقرر.
  instructions  String?
  dueDate       DateTime?
  /// تقييم معمل (دليل · تقرير · نشاط · اختبار عملي) — يُعرض في قسم المعمل.
  isLab         Boolean        @default(false)
  /// نموذج الإجابة — بند مستقل في ملف المقرر، ولا يراه الطالب أبدًا.
  answerKey     String?
  /// رموز مخرجات التعلّم التي يقيسها التقييم — منها يُحسب «المستوى الفعلي» لكل مخرج في تقرير المقرر.
  outcomes      String[]       @default([])
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grades Grade[]

  @@index([workspaceId])
  @@index([courseId])
  @@index([tenantId])
  @@map("assessments")
}

model Grade {
  id           String   @id @default(cuid())
  tenantId     String
  workspaceId  String
  assessmentId String
  enrollmentId String
  score        Decimal  @db.Decimal(6, 2)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, enrollmentId])
  @@index([workspaceId])
  @@index([tenantId])
  @@map("grades")
}

// ───────────────────────── ملف الجودة ─────────────────────────

model QualityFileItem {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  courseId    String
  /// مفتاح بند من `Course.fileItems` (نسخة لائحة الجامعة) — نص لا قائمة ثابتة، وإلا
  /// رُفض كل بند تضيفه جامعة. الصف يُنشأ عند أول تأشير يدوي، لا مسبقًا.
  itemKey     String
  completed   Boolean  @default(false)
  /// مرفقات البند (FileAsset.id) — السيرة الذاتية، نماذج أعمال الطلبة، نتائج تقييم الطلبة…
  fileIds     String[] @default([])
  note        String?
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, itemKey])
  @@index([workspaceId])
  @@index([tenantId])
  @@map("quality_file_items")
}

// ───────────────────────── خط إنتاج الذكاء الاصطناعي ─────────────────────────

enum GenerationJobType {
  FULL_LECTURE
  LECTURE_SCRIPT
  SLIDES
  NARRATION_AUDIO
  VIDEO_RENDER
  PODCAST
  QUESTION_BANK
  COURSE_REPORT_DRAFT
}

enum JobStatus {
  PENDING
  AWAITING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model GenerationJob {
  id                  String            @id @default(cuid())
  tenantId            String
  workspaceId         String
  courseId            String
  createdById         String
  type                GenerationJobType
  status              JobStatus         @default(PENDING)
  estimatedMinutes    Int               @default(0)
  estimatedCostRiyals Decimal           @default(0) @db.Decimal(8, 2)
  actualCostRiyals    Decimal           @default(0) @db.Decimal(8, 2)
  batchMode           Boolean           @default(true)
  /// الموضوع المولَّد له ونوع المخرج المطلوب: TEXT · SLIDES · AUDIO · VIDEO
  topicId             String?
  outputKind          String?
  /// النموذج الذي أنجز المهمة (للمالك وحده — لا يُعرض للأستاذ)
  engine              String?
  /// وصف الأستاذ الحرّ لما يريده («ركّز على التطبيقات السريرية»…)
  instructions        String?
  errorMessage        String?
  resultLectureId     String?
  /// QUOTA = من حصة الباقة الشهرية · WALLET = من رصيد الأستاذ
  paidBy              String            @default("QUOTA")
  /// المحجوز من الرصيد قبل التشغيل، والمخصوم فعلًا بعده (هللة)
  reservedHalalas     Int               @default(0)
  chargedHalalas      Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  steps     JobStep[]

  @@index([workspaceId])
  @@index([courseId])
  @@index([tenantId])
  @@map("generation_jobs")
}

model JobStep {
  id            String    @id @default(cuid())
  tenantId      String
  jobId         String
  stepKey       String
  status        JobStatus @default(PENDING)
  costRiyals    Decimal   @default(0) @db.Decimal(8, 2)
  outputAssetId String?
  outputText    String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([tenantId])
  @@map("job_steps")
}

// ───────────────────────── الملفات (ميتاداتا فقط — المحتوى في التخزين الكائني) ─────────────────────────

model FileAsset {
  id           String    @id @default(cuid())
  tenantId     String
  workspaceId  String
  objectKey    String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  /// R2 = في التخزين الكائني · DB = في `file_blobs` (بديل مؤقت حتى تُضبط مفاتيح R2).
  storage      String    @default("R2")
  /// الغرض: MATERIAL · FILE_ITEM · GENERATED … لحساب الاستهلاك وللتنظيف.
  purpose      String    @default("MATERIAL")
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  blob FileBlob?

  @@index([workspaceId])
  @@index([tenantId])
  @@map("file_assets")
}

/// محتوى الملف حين لا يكون التخزين الكائني مضبوطًا — حتى لا يضيع ملف على قرص Railway المؤقت.
model FileBlob {
  fileId   String    @id
  tenantId String
  data     Bytes
  file     FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("file_blobs")
}

/// نشاط علمي لعضو هيئة التدريس — مصدر السيرة الذاتية والتقرير السنوي للقسم.
model FacultyActivity {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  /// RESEARCH · CONFERENCE · TRAINING · WORKSHOP
  type          String
  title         String
  /// جهة النشر · مكان الانعقاد · جهة التنفيذ
  venue         String?
  date          DateTime @db.Date
  hours         Int?
  /// حضور · ورقة بحثية · مدرب …
  participation String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@map("faculty_activities")
}

// ───────────────────────── المتجر: الباقات والدفع والبنك (مستوى المنصة) ─────────────────────────
//
// هذه الجداول **خارج عزل المستأجرين عمدًا**: الباقات وحسابات البنك وكتالوج البنك تخصّ المنصة
// كلها، والطلبات يراجعها المالك عبر كل الجامعات. العزل هنا بفلتر userId/tenantId صريح في
// طبقة الخدمة (انظر tenantScope.ts — UNSCOPED_MODELS).

model Plan {
  id                  String   @id @default(cuid())
  code                String   @unique
  nameAr              String
  /// TEACHER · DEPARTMENT · STUDENT
  audience            String   @default("TEACHER")
  priceMonthly        Decimal  @db.Decimal(10, 2)
  priceYearly         Decimal  @db.Decimal(10, 2)
  /// حدود الباقة — null = بلا حد
  maxCourses          Int?
  storageMb           Int
  generationsPerMonth Int
  /// عدد مقررات البنك المشمولة سنويًا (VIP)
  bankCoursesPerYear  Int      @default(0)
  features            String[] @default([])
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("plans")
}

model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountName   String
  iban          String
  accountNumber String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_accounts")
}

/// طلب شراء: اشتراك في باقة أو مقرر من البنك. الدفع حاليًا تحويل بنكي بإيصال يراجعه المالك.
model Order {
  id           String    @id @default(cuid())
  /// رقم قصير يكتبه العميل في وصف التحويل — به يطابق المالك الحوالة بالطلب.
  number       String    @unique
  tenantId     String
  userId       String
  /// PLAN · BANK_COURSE
  kind         String
  planId       String?
  /// MONTHLY · YEARLY
  period       String?
  bankCourseId String?
  titleAr      String
  amount       Decimal   @db.Decimal(10, 2)
  /// AWAITING_PAYMENT · UNDER_REVIEW · APPROVED · REJECTED · CANCELED
  status       String    @default("AWAITING_PAYMENT")
  method       String    @default("BANK_TRANSFER")
  payerName    String?
  transferRef  String?
  transferDate DateTime?
  receiptMime  String?
  receiptName  String?
  receiptKey   String?
  receiptData  Bytes?
  submittedAt  DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  /// طلب شحن رصيد (CREDIT): ما يُضاف للمحفظة ورسوم الخدمة بالهللة — يُثبَّتان عند إنشاء الطلب،
  /// فتغيير نسبة الرسوم لاحقًا لا يمسّ طلبًا قائمًا.
  creditHalalas Int?
  feeHalalas    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

/// مقرر في البنك — **كتلة واحدة** تُباع وتُضاف: نسخة كاملة من المقرر (توصيف · فهرس · مواد ·
/// تقييمات بنماذج إجاباتها) بلا طلاب ولا درجات.
model BankCourse {
  id             String    @id @default(cuid())
  title          String
  code           String
  specialization String
  university     String
  description    String    @default("")
  level          String    @default("")
  /// 0 = مجاني
  price          Decimal   @default(0) @db.Decimal(10, 2)
  /// يُتاح بحصة VIP في الباقة
  vipIncluded    Boolean   @default(true)
  /// DRAFT · PENDING · PUBLISHED · REJECTED · ARCHIVED
  status         String    @default("PENDING")
  content        Json
  /// ملخّص للعرض قبل الشراء: عدد المواضيع والمواد والتقييمات والمخرجات
  summary        Json      @default("{}")
  sourceCourseId String?
  sourceTenantId String?
  version        Int       @default(1)
  importsCount   Int       @default(0)
  reviewNote     String?
  /// النسخة الجديدة المسحوبة عند إقفال فصل ولم يعتمدها المالك بعد: { content, summary, authorId, authorName, university, termLabel }.
  /// المنشور يبقى كما هو حتى الاعتماد — لا يتغيّر منتج معروض للبيع بلا مراجعة.
  draft          Json?
  draftAt        DateTime?
  /// تقييم المحرّك للمقرر: درجات المعايير والقوة والضعف والسعر المقترح وتعليله
  evaluation     Json?
  suggestedPrice Decimal?  @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  authors  BankCourseAuthor[]
  accesses BankCourseAccess[]

  @@index([status, specialization])
  @@index([sourceCourseId])
  @@map("bank_courses")
}

/// جدول المؤلفين: من أنشأ المقرر ومن عدّله ومتى — سجل لا يُحذف منه.
model BankCourseAuthor {
  id           String   @id @default(cuid())
  bankCourseId String
  userId       String
  userName     String
  university   String
  /// CREATOR · EDITOR · REVIEWER
  role         String
  note         String?
  version      Int
  createdAt    DateTime @default(now())

  bankCourse BankCourse @relation(fields: [bankCourseId], references: [id], onDelete: Cascade)

  @@index([bankCourseId])
  @@index([userId])
  @@map("bank_course_authors")
}

/// حقّ الوصول لمقرر في البنك: بشراء · بحصة VIP · مجاني · مؤلفه.
model BankCourseAccess {
  id           String   @id @default(cuid())
  bankCourseId String
  userId       String
  tenantId     String
  /// PURCHASE · VIP · FREE · AUTHOR
  via          String
  orderId      String?
  createdAt    DateTime @default(now())

  bankCourse BankCourse @relation(fields: [bankCourseId], references: [id], onDelete: Cascade)

  @@unique([bankCourseId, userId])
  @@index([userId])
  @@map("bank_course_access")
}

/// ربط حساب Google للأستاذ — رمز التحديث مشفّر (AES-256-GCM). منه تُشغَّل الأتمتة على حسابه.
model GoogleConnection {
  userId          String   @id
  email           String
  scopes          String
  refreshTokenEnc String
  connectedAt     DateTime @default(now())

  @@map("google_connections")
}

/// مصادر المقرر التي يرفعها الأستاذ للتوليد (PDF · Word · PowerPoint · نص). مرتبطة بالمقرر،
/// واختياريًا بموضوع. نص Word وPowerPoint يُستخرج مرة عند الرفع ويُحفظ هنا، وPDF يُقرأ كما هو.
model SourceFile {
  id          String    @id @default(cuid())
  tenantId    String
  workspaceId String
  courseId    String
  topicId     String?
  fileId      String
  title       String
  mimeType    String
  sizeBytes   Int
  textContent String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([courseId])
  @@index([tenantId])
  @@map("source_files")
}

/// إعدادات المنصة التي يتحكّم بها المالك (الميزانية · أسعار الرموز · مدة التجربة …) — مفتاح وقيمة.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// كل نداء للمحرّك الذكي بتكلفته — منه تُحسب ميزانية الشهر ويُوقف التوليد قبل تجاوزها.
model AiUsage {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  /// GENERATION · ASSISTANT · BANK_REVIEW · REGULATION_EXTRACT
  feature      String
  model        String   @default("")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  audioTokens  Int      @default(0)
  costSar      Decimal  @default(0) @db.Decimal(10, 4)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

/// ما يرفعه الأستاذ عن جامعته (هيكل ملف المقرر · اللائحة · مخالفات أعضاء هيئة التدريس …).
/// المالك يراجعه ويستخرج منه لائحة الجامعة ويعتمدها — فتُبنى لوائح كل جامعة جديدة بلا مقابل.
model UniversitySubmission {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  /// COURSE_FILE · REGULATION · FACULTY_VIOLATIONS · OTHER
  kind        String
  fileId      String?
  title       String
  mimeType    String?
  textContent String?
  note        String    @default("")
  /// PENDING · APPLIED · DISMISSED
  status      String    @default("PENDING")
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, status])
  @@map("university_submissions")
}

/// إشعار العمل لمستخدم واحد — يُكتب لحظة الحدث (طلب اعتُمد · توليد اكتمل · حرمان …) لا يُحسب
/// عند كل فتح للجرس: العدّاد استعلام مفهرس واحد مهما كثر المستخدمون. يُحذف ما مضى عليه ٩٠ يومًا.
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  /// نوع الحدث (ORDER_APPROVED · GENERATION_DONE · ABSENCE_BAN …) — للأيقونة والتجميع
  kind      String
  title     String
  body      String   @default("")
  /// مسار داخل المنصة يفتحه النقر
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tenantId])
  @@map("notifications")
}

/// صورة الملف الشخصي في وضع التخزين «DB» فقط (بلا R2) — مصغّرة ٢٥٦px ولا تتجاوز ٦٤ كيلوبايت.
/// مع R2 تُحفظ هناك ولا يُستخدم هذا الجدول. خارج العزل كجدول المستخدمين نفسه.
model UserAvatar {
  userId    String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// محفظة الأستاذ (لكل مساحة عمل) — الرصيد بالهللة عددًا صحيحًا لا كسورًا عشرية.
/// لا يُعدَّل إلا بتحديث مشروط ذرّي (balance >= المبلغ) مع قيد في الدفتر في المعاملة نفسها.
model Wallet {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String   @unique
  balance     Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("wallets")
}

/// دفتر المحفظة — إضافة فقط. TOPUP (+) شحن معتمد · RESERVE (−) حجز قبل التوليد ·
/// REFUND (+) ردّ الفرق بعد التوليد أو كله عند الفشل · ADJUST (±) تصحيح يدوي من المالك.
model WalletEntry {
  id           String   @id @default(cuid())
  tenantId     String
  workspaceId  String
  kind         String
  amount       Int
  balanceAfter Int
  orderId      String?
  jobId        String?
  note         String   @default("")
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([tenantId])
  @@map("wallet_entries")
}
