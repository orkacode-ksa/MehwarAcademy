# انسخ هذا الملف إلى server/.env واملأ القيم الحقيقية. لا تضع أسرارًا حقيقية هنا أبدًا.

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@localhost:5432/mihwar?schema=public&connection_limit=10"

APP_URL="http://localhost:5173"
API_ORIGIN="http://localhost:4000"
CLIENT_ORIGINS="http://localhost:5173"

JWT_ACCESS_SECRET="__64_byte_hex_openssl_rand_hex_64__"
JWT_REFRESH_SECRET="__64_byte_hex_openssl_rand_hex_64__"
JWT_ISSUER="mihwar-platform"
JWT_AUDIENCE="mihwar-clients"

ENCRYPTION_KEY="__32_byte_hex_openssl_rand_hex_32__"

# اختياري — يُفعَّل فقط بعد ربط Cloudflare أمام النطاق (القسم §17 من الدستور الأمني)
CF_ORIGIN_SECRET=""

# اختياري — Redis لتحديد المعدل والكاش الموزّع؛ غيابه يفعّل وضع تدهور رشيق في نسخة واحدة
REDIS_URL=""

# اختياري — مفاتيح المزوّدات الخارجية؛ غيابها يفعّل الوضع الوهمي في كل adapter
GEMINI_API_KEY=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_ORIGIN=""
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
INVOICE_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="no-reply@mihwar.local"

SENTRY_DSN=""

CHROMIUM_EXECUTABLE_PATH=""
